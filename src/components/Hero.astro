---
import { Image } from 'astro:assets';
import type { SiteConfig } from '../config/site.types';

interface Props {
  config: SiteConfig;
}
const { config } = Astro.props;
---

<section id="inicio" class="relative overflow-hidden bg-primary-light/30">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-14 sm:px-8 sm:py-20 lg:grid-cols-2 lg:gap-16 lg:py-28">
    <div class="order-2 lg:order-1">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary">{config.hero.eyebrow}</p>
      <h1 class="mt-3 font-heading text-4xl font-bold leading-tight text-ink sm:text-5xl lg:text-[3.25rem]">
        {config.hero.title}
      </h1>
      <p class="mt-5 max-w-xl text-lg text-ink/70">
        {config.hero.subtitle}
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={`https://wa.me/${config.hoursLocation.whatsappNumber}`} class="btn-primary">
          {config.hero.ctaLabel}
        </a>
        <a href={config.hero.secondaryHref} class="btn-outline">
          {config.hero.secondaryLabel}
        </a>
      </div>
      <p class="mt-6 flex items-center gap-2 text-sm text-ink/60">
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-green-500" aria-hidden="true"></span>
        {config.meta.city}, {config.meta.province}
      </p>
    </div>
    <div class="order-1 lg:order-2">
      <Image
        src={config.hero.image}
        alt={config.hero.imageAlt}
        widths={[400, 700, 900]}
        sizes="(min-width: 1024px) 560px, 100vw"
        class="aspect-[4/3] w-full rounded-3xl object-cover shadow-xl"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
