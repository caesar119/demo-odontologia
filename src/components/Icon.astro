const d = paths[name] ?? paths.sparkle;
const filled = name === 'tooth' || name === 'flame' || name === 'heart' || name === 'whatsapp';
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={d}></path>
</svg>
