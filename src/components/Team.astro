---
import { Image } from 'astro:assets';
import type { SiteConfig } from '../config/site.types';

interface Props {
  config: SiteConfig;
}
const { config } = Astro.props;
---

<section id="equipo" class="bg-ink/[0.03] py-16 sm:py-20 lg:py-24">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <h2 class="section-heading">{config.team.heading}</h2>
    <p class="section-subheading">{config.team.subheading}</p>

    <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {config.team.members.map((member) => (
        <div class="text-center">
          <Image
            src={member.photo}
            alt={member.alt}
            widths={[300, 500]}
            sizes="300px"
            class="mx-auto aspect-square w-48 rounded-full object-cover shadow-md"
            loading="lazy"
          />
          <h3 class="mt-4 text-lg font-semibold text-ink">{member.name}</h3>
          <p class="text-ink/60">{member.role}</p>
        </div>
      ))}
    </div>
  </div>
</section>
