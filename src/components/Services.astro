---
import Icon from './Icon.astro';
import type { SiteConfig } from '../config/site.types';

interface Props {
  config: SiteConfig;
}
const { config } = Astro.props;
---

<section id="servicios" class="section">
  <h2 class="section-heading">{config.services.heading}</h2>
  <p class="section-subheading">{config.services.subheading}</p>

  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {config.services.items.map((item) => (
      <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary-light/40 text-primary">
          <Icon name={item.icon} class="h-6 w-6" />
        </div>
        <h3 class="mt-4 text-lg font-semibold text-ink">{item.title}</h3>
        <p class="mt-2 text-ink/70">{item.description}</p>
      </div>
    ))}
  </div>
</section>
